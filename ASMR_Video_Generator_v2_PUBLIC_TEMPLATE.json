      "id": "a83e50da-a721-4cca-8b8b-76203aacda53",
      "name": "Get row(s) in sheet",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst newTitle = input.output.videofile;\n\nconst rows = $('Get row(s) in sheet').all();\n\nconst existingTitles = rows\n  .map(item => item.json[\"Video Title\"])\n  .filter(title => typeof title === \"string\" && title.trim());\n\nconst retryCount = Number(input.retryCount ?? 0);\n\nconst rejectedTitles = Array.isArray(input.rejectedTitles)\n  ? input.rejectedTitles\n  : [];\n\nconst stopWords = new Set([\n  \"asmr\", \"jelly\", \"glass\", \"slicing\",\n  \"slice\", \"slices\", \"sound\", \"sounds\",\n  \"satisfying\", \"video\", \"the\", \"a\"\n]);\n\nfunction getKeywords(title) {\n  return title.toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, \"\")\n    .split(/\\s+/)\n    .filter(word => word && !stopWords.has(word));\n}\n\nconst newKeywords = getKeywords(newTitle);\n\nconst isDuplicate = [...existingTitles, ...rejectedTitles]\n  .some(title => {\n    const oldKeywords = getKeywords(title);\n\n    return newKeywords.length > 0 &&\n      oldKeywords.length > 0 &&\n      newKeywords.some(word => oldKeywords.includes(word));\n  });\n\nreturn [{\n  json: {\n    newTitle,\n    existingTitles,\n    isDuplicate,\n    retryCount,\n    rejectedTitles: isDuplicate\n      ? [...rejectedTitles, newTitle]\n      : rejectedTitles\n  }\n}];"
      },
